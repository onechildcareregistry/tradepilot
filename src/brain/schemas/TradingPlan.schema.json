{
  "type": "object",
  "properties": {
    "tradingDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "brainVersion": {
      "type": "string",
      "const": "V0.2"
    },
    "promptVersion": {
      "type": "string",
      "const": "trading-brain-v0.2"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cutoffAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "marketRegime": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"
          },
          "company": {
            "type": "string",
            "minLength": 1
          },
          "exchange": {
            "type": "string",
            "enum": [
              "NASDAQ",
              "NYSE"
            ]
          },
          "securityType": {
            "type": "string",
            "const": "common_stock"
          },
          "explosionScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "entryQuality": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "catalyst": {
            "type": "string"
          },
          "catalystSignificance": {
            "type": "string"
          },
          "premarket": {
            "type": "object",
            "properties": {
              "price": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "changePercent": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "volume": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "exhaustionScore": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "price",
              "changePercent",
              "volume",
              "exhaustionScore"
            ],
            "additionalProperties": false
          },
          "marketCap": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "floatShares": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "triggerPrice": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "stopConcept": {
            "type": "string"
          },
          "initialTarget": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "maximumAllocation": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 0.2
          },
          "setupType": {
            "type": "string",
            "const": "opening_range_breakout"
          },
          "reasoning": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "title": {
                  "type": "string"
                },
                "publishedAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "retrievedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "cutoffVerified": {
                  "type": "boolean"
                },
                "excerpt": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "title",
                "publishedAt",
                "retrievedAt",
                "cutoffVerified",
                "excerpt"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "rank",
          "symbol",
          "company",
          "exchange",
          "securityType",
          "explosionScore",
          "entryQuality",
          "catalyst",
          "catalystSignificance",
          "premarket",
          "marketCap",
          "floatShares",
          "triggerPrice",
          "stopConcept",
          "initialTarget",
          "maximumAllocation",
          "setupType",
          "reasoning",
          "sources",
          "confidence",
          "uncertainties"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 3
    }
  },
  "required": [
    "tradingDate",
    "brainVersion",
    "promptVersion",
    "model",
    "generatedAt",
    "cutoffAt",
    "expiresAt",
    "marketRegime",
    "candidates"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
