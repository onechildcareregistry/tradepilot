{
  "name": "tradepilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite dashboard --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && vite build dashboard",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests dashboard/src",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "demo": "tsx src/cli.ts demo",
    "status": "tsx src/cli.ts status",
    "worker": "tsx src/cli.ts worker",
    "research": "tsx src/cli.ts research",
    "verify-data": "tsx src/cli.ts verify-data",
    "migrate": "tsx src/cli.ts migrate",
    "admin": "tsx src/cli.ts",
    "infra:check": "az bicep build --file infra/main.bicep --stdout > /dev/null",
    "schema": "tsx scripts/generate-schema.ts",
    "configure:azure-openai": "tsx scripts/configure-azure-openai.ts",
    "configure:deployment": "tsx scripts/create-deployment-parameters.ts",
    "configure:azure-runtime": "tsx scripts/configure-azure-runtime.ts",
    "format": "prettier --write src tests scripts dashboard/src dashboard/index.html docs README.md",
    "format:check": "prettier --check src tests scripts dashboard/src dashboard/index.html docs README.md",
    "test:sql": "SQL_LOCAL_TEST=true vitest run tests/persistence.test.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.6.0",
    "@azure/storage-blob": "^12.26.0",
    "better-sqlite3": "^12.11.1",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "moment-timezone": "0.6.2",
    "mssql": "^11.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "prettier": "^3.9.8",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.2",
    "vitest": "^4.1.11"
  }
}
